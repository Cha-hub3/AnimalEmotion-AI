    {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["# Build audit summary without asserting unknown facts\n","readable_count=int(len(valid)); corrupt_count=int(len(corrupt)); dup_group_count=int(len(exact_duplicate_groups))
